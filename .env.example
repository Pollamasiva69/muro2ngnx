# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and update with your values
# ==============================================================================

# Domain Configuration
DOMAIN=yourdomain.com
CERTBOT_EMAIL=admin@yourdomain.com

# Redis Configuration
REDIS_PASSWORD=changeme_redis_password_use_strong_password
REDIS_HOST=redis-master-1
REDIS_PORT=6379

# ML Service Configuration
ML_SERVICE_HOST=ml-service
ML_SERVICE_PORT=9000

# Security
JWT_SECRET=changeme_generate_random_secret_minimum_32_chars
API_KEY=changeme_api_key_for_management_endpoints

# Database Configuration
CLICKHOUSE_PASSWORD=changeme_clickhouse_password
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123

# Monitoring
GRAFANA_PASSWORD=changeme_grafana_admin_password
PROMETHEUS_RETENTION=90d

# Application Settings
LOG_LEVEL=info
ENVIRONMENT=production

# Rate Limiting (requests per second)
RATE_LIMIT_GLOBAL=1000
RATE_LIMIT_API=100
RATE_LIMIT_LOGIN=5

# Threat Score Thresholds (0-100)
THRESHOLD_BLOCK=81
THRESHOLD_CHALLENGE=61
THRESHOLD_RATE_LIMIT=31

# GeoIP Blocking (comma-separated country codes)
BLOCKED_COUNTRIES=

# Whitelist IPs (comma-separated)
WHITELISTED_IPS=127.0.0.1,10.0.0.0/8

# Feature Flags
ENABLE_ML_CLASSIFICATION=true
ENABLE_CHALLENGE_RESPONSE=true
ENABLE_GEOIP_BLOCKING=false
ENABLE_MODSECURITY=true

# Performance Tuning
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=65535
REDIS_MAXMEMORY=2gb

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
