# ==============================================================================
# Dockerfile for ML Threat Detection Service (Rust)
# Multi-stage build for minimal production image
# ==============================================================================

FROM rust:1.75-alpine AS builder

# Install build dependencies
RUN apk add --no-cache musl-dev openssl-dev

WORKDIR /app

# Copy manifests
COPY Cargo.toml Cargo.lock ./

# Build dependencies (cached layer)
RUN mkdir src && \
    echo "fn main() {}" > src/main.rs && \
    cargo build --release && \
    rm -rf src

# Copy source code
COPY src ./src

# Build application
RUN cargo build --release --bin ml-service

# ==============================================================================
# Production image
# ==============================================================================
FROM alpine:latest

RUN apk add --no-cache ca-certificates libgcc

WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/target/release/ml-service /app/ml-service

# Create directories
RUN mkdir -p /app/models

# Expose port
EXPOSE 9000

# Run as non-root user
RUN addgroup -g 1000 mlservice && \
    adduser -D -u 1000 -G mlservice mlservice && \
    chown -R mlservice:mlservice /app

USER mlservice

CMD ["/app/ml-service"]
